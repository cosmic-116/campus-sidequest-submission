# Copy to .env for an existing local MySQL instance. local:init creates its own .env.
DB_HOST=127.0.0.1
DB_PORT=3407
DB_NAME=campus_sidequest
DB_USER=csq_runtime
DB_PASSWORD=replace_with_your_runtime_password
MIGRATION_USER=csq_migration
MIGRATION_PASSWORD=replace_with_your_migration_password
REPORT_USER=csq_report
REPORT_PASSWORD=replace_with_your_reporting_password
SESSION_SECRET=replace_with_a_long_random_secret
PORT=3000
